# =============================================================================
# terraform.tfvars.example - Example Configuration
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values:
#   cp terraform.tfvars.example terraform.tfvars
#
# Get values from your podcast pipeline:
#   cd ../podcast-pipeline-terraform
#   terraform output
# =============================================================================

# -----------------------------------------------------------------------------
# Project Settings
# -----------------------------------------------------------------------------

project_name = "mcp-server"
environment  = "dev"
aws_region   = "eu-west-3"

# -----------------------------------------------------------------------------
# References from Podcast Pipeline (run 'terraform output' in that project)
# -----------------------------------------------------------------------------

vpc_id                = "vpc-xxxxxxxxx"           # Your VPC ID
subnet_ids            = ["subnet-xxx", "subnet-yyy"]  # At least 2 subnets
efs_file_system_id    = "fs-xxxxxxxxx"            # EFS file system ID
efs_access_point_id   = "fsap-xxxxxxxxx"          # EFS access point ID
efs_security_group_id = "sg-xxxxxxxxx"            # Security group for EFS access
ecr_repository_url    = "123456789.dkr.ecr.eu-west-3.amazonaws.com/your-repo"

# -----------------------------------------------------------------------------
# MCP Server Container Settings
# -----------------------------------------------------------------------------

container_image_tag = "mcp-server-latest"
container_port      = 8080
container_cpu       = 1024   # 1 vCPU
container_memory    = 2048   # 2 GB

# EFS mount paths
efs_mount_path = "/mnt/efs"
chromadb_path  = "/mnt/efs/chromadb"

# -----------------------------------------------------------------------------
# Scaling (App Runner)
# -----------------------------------------------------------------------------

min_instances   = 1    # App Runner minimum is 1 (but scales down to pause)
max_instances   = 2
max_concurrency = 50   # Requests per instance before scaling

# -----------------------------------------------------------------------------
# Environment Variables
# -----------------------------------------------------------------------------

container_environment = {
  LOG_LEVEL = "INFO"
  # Add any other env vars your MCP server needs
}

# HuggingFace token for embeddings (if needed)
hf_token = "hf_xxxxxxxxxx"
